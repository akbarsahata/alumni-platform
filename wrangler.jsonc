{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alumni-platform",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:5173",
    "EMAIL_FROM": "iam@akbarsahata.id",
    "EMAIL_REPLY_TO": "iam@akbarsahata.id",
    "ENVIRONMENT": "development",
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "LOCAL_MAIL_KEY", "RESEND_API_KEY"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alumni_local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [{ "binding": "LOCAL_MAIL", "id": "00000000000000000000000000000000" }],
}
