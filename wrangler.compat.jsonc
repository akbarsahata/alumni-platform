{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "alumni-ticket0-compat",
	"main": "./workers/compatibility-smoke.ts",
	"compatibility_date": "2026-10-01",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "alumni_ticket0",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "./migrations"
		}
	],
	"vars": {
		"BETTER_AUTH_SECRET": "ticket0-local-only-secret-0123456789abcdef0123456789",
		"BETTER_AUTH_URL": "http://127.0.0.1:8788"
	}
}