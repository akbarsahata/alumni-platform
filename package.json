{
  "name": "alumni-ticket0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/clean-wrangler-redirect.mjs",
    "build": "react-router build",
    "predev": "node scripts/clean-wrangler-redirect.mjs",
    "dev": "react-router dev",
    "pretypecheck": "node scripts/clean-wrangler-redirect.mjs",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "node scripts/deploy.mjs",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production": "node scripts/deploy.mjs production",
    "preview": "npm run build && vite preview",
    "precf-typegen": "node scripts/clean-wrangler-redirect.mjs",
    "cf-typegen": "wrangler types",
    "postinstall": "node scripts/clean-wrangler-redirect.mjs && wrangler types",
    "local:setup": "node scripts/local-setup.mjs",
    "predb:migrate": "node scripts/clean-wrangler-redirect.mjs",
    "db:migrate": "wrangler d1 migrations apply alumni_local --local",
    "pretest": "node scripts/clean-wrangler-redirect.mjs",
    "test": "node scripts/test.mjs",
    "test:http": "node --test tests/auth.test.mjs",
    "test:browser": "playwright test",
    "mail": "node scripts/read-mail.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "prepare": "husky",
    "format": "prettier --ignore-unknown --write .",
    "format:check": "prettier --ignore-unknown --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "locations:generate": "node scripts/generate-profile-locations.mjs",
    "test:unit": "node --test tests/location-list.test.mjs tests/email-delivery.test.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
